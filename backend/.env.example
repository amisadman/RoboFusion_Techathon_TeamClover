# Local (docker-compose postgres). In production, replace with the
# managed Postgres URL from Render/Railway.
DATABASE_URL="postgresql://scsrg:scsrg@localhost:5432/scsrg?schema=public"

PORT=4000

# The deployed Next.js/Vercel URL. Must match exactly (scheme + host,
# no trailing slash) or CORS + Better Auth cookies will silently fail.
FRONTEND_URL="http://localhost:3000"

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:4000"

NODE_ENV="development"
