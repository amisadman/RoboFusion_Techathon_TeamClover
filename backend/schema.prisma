generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean
  image         String?
  role          String     @default("staff")
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  incidents     Incident[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Zone {
  id            String     @id // e.g. "iot_lab"
  name          String
  apiKey        String     @unique
  hazardProfile String
  archived      Boolean    @default(false)
  lastSeenAt    DateTime?
  sensors       Sensor[]
  readings      Reading[]
  incidents     Incident[]
}

model Sensor {
  id     String @id @default(cuid())
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  type   String
  unit   String
}

model Reading {
  id         String   @id @default(cuid())
  zoneId     String
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  seq        Int
  flameRaw   Int
  gasRaw     Int
  waterRaw   Int
  motion     Boolean
  riskScore  Float
  state      String
  recordedAt DateTime // device clock (timestamp_ms from payload)
  receivedAt DateTime @default(now()) // server clock

  @@unique([zoneId, seq]) // DB-level dedup backstop for Test 6d
  @@index([zoneId, receivedAt])
}

model Incident {
  id            String   @id @default(cuid())
  zoneId        String
  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  status        String // OPEN | ACKED | RESOLVED
  hazardTypes   String[]
  peakRiskScore Float
  source        String // sensor | manual_override | nl_report

  openedAt       DateTime  @default(now())
  acknowledgedBy String?
  ackUser        User?     @relation(fields: [acknowledgedBy], references: [id])
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  transitions IncidentTransition[]

  @@index([status, openedAt]) // the single biggest win for Test 19
}

model IncidentTransition {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromState  String?
  toState    String
  riskScore  Float
  occurredAt DateTime @default(now())
}
