# better-auth's package.json declares peerOptional deps for every DB
# adapter it supports (mysql2, mongodb, drizzle-orm, prisma, kysely...)
# even though we only use the Prisma adapter on the backend. npm's
# strict ERESOLVE peer checking sometimes fails on these unrelated
# optional peers. We only ever import better-auth/react here, so this
# is safe to relax.
legacy-peer-deps=true
